# Copy to .env and adjust. .env is git-ignored: never commit real credentials.
# Every value below is injected at runtime by docker compose (D4).

# ---------------- Infrastructure ----------------
REDIS_URL=redis://redis:6379/0
# OTLP/HTTP endpoint for traces (Jaeger all-in-one). Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=INFO

# Host ports (optional overrides)
API_PORT=8000
LLM_STUB_PORT=8001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
LOCUST_PORT=8089

# ---------------- API ----------------
# Comma-separated browser origins allowed to call the API (the web client).
CORS_ALLOW_ORIGINS=http://localhost:8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384

# ---------------- Run lifecycle / loop bounds (A1) ----------------
RUN_WALL_CLOCK_TIMEOUT_S=120
RUN_MAX_STEPS=12
RUN_MAX_TOOL_CALLS=20
RUN_MAX_LLM_CALLS=10
RUN_MAX_ATTEMPTS=2
TOOL_TIMEOUT_S=10
# How long run records and event logs are kept (seconds; 604800 = 7 days)
RUN_TTL_SECONDS=604800
# Whole-run cache TTL in seconds (D7). 0 disables.
RUN_CACHE_TTL_SECONDS=0

# ---------------- Worker ----------------
# Port of the worker's /metrics endpoint (must match observability/prometheus/prometheus.yml)
WORKER_METRICS_PORT=9100
# A worker whose heartbeat is older than this is considered dead and its runs are requeued
WORKER_HEARTBEAT_TTL_S=30

# ---------------- Agent ----------------
# module:Class implementing app.agents.base.AgentRunner. The stub never classifies.
AGENT_RUNNER=app.agents.stub_runner:StubAgentRunner

# ---------------- Model provider (OpenAI-compatible chat completions) ----------------
# Default points at the local stub. For a real provider set its base URL, key and model here.
LLM_BASE_URL=http://llm-stub:8001/v1
LLM_API_KEY=
LLM_MODEL=stub-model
# USD per 1K tokens, recorded at call time (L5)
LLM_PRICE_PROMPT_PER_1K=0
LLM_PRICE_COMPLETION_PER_1K=0
# Optional fallback provider used when the primary fails or its circuit is open
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRICE_PROMPT_PER_1K=0
LLM_FALLBACK_PRICE_COMPLETION_PER_1K=0

# ---------------- Resilience (A5) ----------------
LLM_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_S=0.5
LLM_BACKOFF_MAX_S=8
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_S=30

# ---------------- LLM stub (load tests, failure demos) ----------------
STUB_LATENCY_MS=1500
STUB_LATENCY_JITTER_MS=500
STUB_SLOW_SECONDS=120

# ---------------- Grafana ----------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# ---------------- Load test ----------------
LOADTEST_POLL_INTERVAL_S=0.5
LOADTEST_RUN_TIMEOUT_S=180
